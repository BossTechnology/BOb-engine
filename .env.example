# The feeder's entry point (feeder/main.mjs). Copy to a real env file OUTSIDE the
# repository and fill it in; never commit one. Every value below is an example.
# What reads them, and how to invoke it: feeder/README.md.
#
# Secrets are files, mode 600 (P5 §3.4): the variables name the file, not the secret.

# ── bzzz-vecinos: the box's read service (HTTPS, mutual TLS) ────────────────
BOB_VECINOS_URL=https://bzzz-vecinos:8443
# The vecinas' CA, and BOb's client certificate and key (the certificate's CN is `bob`).
BOB_VECINOS_CA_FILE=/opt/bob/secrets/vecinos-mtls/ca.pem
BOB_VECINOS_CERT_FILE=/opt/bob/secrets/vecinos-mtls/bob.pem
BOB_VECINOS_KEY_FILE=/opt/bob/secrets/vecinos-mtls/bob.key
# The box's own `bzzz.tenant`. Required: it is what keeps another tenant's event out.
BOB_VECINOS_TENANT=tenant-demo
# Optional. The `source`s of the box's channels, comma separated. Unset: the source_key
# of every channel BOb holds for this tenant (SR-2).
# BOB_VECINOS_SOURCES=tenant-demo.web,tenant-demo.whatsapp
# The size of one query window, in seconds, a multiple of 300. Configuration, not a
# constant: one day fits the bench's volume, not necessarily a customer's.
BOB_VECINOS_WINDOW_SECONDS=86400
# Rows per page, 1 to 500 (the service's ceiling).
BOB_VECINOS_PAGE_LIMIT=500
# marca_de_agua looks at sources with events in the last N days, 1 to 30.
BOB_VECINOS_WATERMARK_DAYS=2
# One request, in milliseconds. The service itself cuts a request at 20 000.
BOB_VECINOS_TIMEOUT_MS=30000
# 429, 503, a dropped connection and a timeout are retried this many times, waiting
# Retry-After if the service sends it, else RETRY_BASE_MS doubling.
BOB_VECINOS_MAX_RETRIES=3
BOB_VECINOS_RETRY_BASE_MS=1000

# ── The feeder ──────────────────────────────────────────────────────────────
# The connection of bob_feeder: a file holding the URL (preferred), or the URL itself.
BOB_FEEDER_DB_URL_FILE=/opt/bob/secrets/feeder-db-url
# BOB_FEEDER_DB_URL=postgres://bob_feeder:CHANGE-ME@supabase-db:5432/postgres
# A rebuild (--from/--to) runs in steps of this many seconds, a multiple of 300.
BOB_FEEDER_STEP_SECONDS=86400
# An ordinary run replays this much, up to the watermark, a multiple of 300.
BOB_FEEDER_LOOKBACK_SECONDS=86400
# How far before a window the feeder reads to know a conversation's state.
BOB_FEEDER_CONTEXT_SECONDS=86400
# Optional. How far past a window it reads for labels that arrive after their turn.
# Unset: up to the watermark (the reference behaviour). A rebuild of a year needs it
# set, or each day reads every day since; a label later than this reads as missing.
# BOB_FEEDER_READ_AHEAD_SECONDS=86400
# Optional. Written in every row.
# BOB_FEEDER_VERSION=reference-feeder/0.1+vecinos
